    .user-row:hover .user-actions { opacity: 1; }
    .user-row .user-actions .icon-btn { width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #2f3136; transition: all 0.2s; }
    .user-row .user-actions .icon-btn:hover { background: #40444b; color: #fff; }
    
    .request-item { display: none; } /* Legacy cleanup */

    .room-card.private { border-left: 4px solid #da373c; }
    .room-card.friends { border-left: 4px solid #e0c20a; }
    .room-card.invited { border-left: 4px solid #5865f2; background-color: rgba(88, 101, 242, 0.1); } /* Highlight invited rooms */

    .empty-rooms { grid-column: 1 / -1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 48px; border: 2px dashed #404249; border-radius: 8px; color: #949ba4; }
    .btn-link { background: none; border: none; color: #00aff4; cursor: pointer; padding: 0; text-decoration: underline; font-size: inherit; }

    /* Mobile Responsive */
    .mobile-menu-btn { display: none; background: none; border: none; color: white; font-size: 20px; cursor: pointer; margin-right: 16px; }
    .mobile-backdrop { display: none; }

    /* Truncation for friends list names */
    .user-info { flex: 1; min-width: 0; overflow: hidden; display: flex; align-items: center; }
    .name { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; }

    @media (max-width: 768px) {
        .dashboard-grid { grid-template-columns: 1fr; }
        .sidebar-nav { 
            position: fixed; 
            top: 48px; 
            bottom: 0; 
            left: -100%; /* Hidden off-screen */
            width: 80%; 
            max-width: 320px; 
            z-index: 1000; 
            background: #2b2d31; 
            transition: left 0.3s ease; 
            box-shadow: 2px 0 5px rgba(0,0,0,0.5);
        }
        .sidebar-nav.mobile-active { left: 0; }
        
        .mobile-menu-btn { display: block; }
        .mobile-backdrop { position: fixed; top: 48px; bottom: 0; left: 0; right: 0; background: rgba(0,0,0,0.5); z-index: 999; display: block; }

        .friends-header { flex-direction: column; align-items: stretch; gap: 8px; }
        .friend-search-input { width: 100%; box-sizing: border-box; } 
        
        .cards-grid { grid-template-columns: 1fr; } /* Stack room cards */
    }
