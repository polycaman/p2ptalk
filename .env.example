# ╔══════════════════════════════════════════════════════════╗
# ║  p2ptalk.org — Environment Configuration               ║
# ║  Copy this file to .env and fill in your values         ║
# ║  docker compose up -d  — that's it!                     ║
# ╚══════════════════════════════════════════════════════════╝

# ─── Domain & SSL ─────────────────────────────────────────
DOMAIN=p2ptalk.org
CERTBOT_EMAIL=admin@p2ptalk.org

# ─── Database (PostgreSQL) ────────────────────────────────
POSTGRES_USER=p2ptalk
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=p2ptalk_db

# ──────────────────────────────────────────────────────────
# The variables below are AUTO-DERIVED by docker-compose.yml
# from the values above.  You do NOT need to set them.
# Override only for local development or non-Docker setups.
# ──────────────────────────────────────────────────────────
# DATABASE_URL=postgres://p2ptalk:YOUR_PASSWORD@localhost:5432/p2ptalk_db
# ORIGIN=https://p2ptalk.org
# NODE_ENV=production
